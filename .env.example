# Copy to .env and set your OWN keys. Never commit .env.
PORT=7860
# Optional server-side model key (incurs costs). Leave empty for user-supplied keys.
OPENROUTER_API_KEY=
# Set strong, unique authentication before exposing the API publicly.
HACKERMODE_API_KEY=
# Restrict to your frontend origin in public deployments.
CORS_ORIGIN=http://localhost:3000
# Optional Hugging Face dataset publication: leave disabled unless intentionally configured.
HF_TOKEN=
HF_DATASET_REPO=
